# Cloudflare Pages redirects. First match wins, so the two articles that moved
# to /knowledge/ must come before the /blog/* catch-all.
# Long-form writing lives at dialogues.bluedobiedev.com; /dialogues is the on-site
# landing page for it. The local blog was retired 2026-09-23 and Medium 2026-09-26.

/blog/cost-of-a-sm-biz-site        /knowledge/small-business-website-cost/  301
/blog/cost-of-a-sm-biz-site/       /knowledge/small-business-website-cost/  301
/blog/why-website-audit-highest-roi   /knowledge/website-audit-roi/  301
/blog/why-website-audit-highest-roi/  /knowledge/website-audit-roi/  301

/blog        /dialogues  301
/blog/       /dialogues  301
/blog/*      /dialogues  301
/blog-home       /dialogues  301
/blog-home.html  /dialogues  301

/dialogues-medium       /dialogues  301
/dialogues-medium.html  /dialogues  301

/tags     /knowledge/  301
/tags/    /knowledge/  301
/tags/*   /knowledge/  301

# DobieCore: the Suite landing page lives at /dobiecore/ (permalink on
# DobieCoreSuite.html). These are the older addresses still in circulation.
/dobiecore-captions       /dobiecore/  301
/dobiecore-captions/      /dobiecore/  301
/dobiecore-captions.html  /dobiecore/  301
/DobieCoreSuite           /dobiecore/  301
/DobieCoreSuite/          /dobiecore/  301
/DobieCoreSuite.html      /dobiecore/  301

# Retired blog tag links used a hyphen, not a slash, so the /tags/* rule
# above never matched them. 19 of these showed up in GA4 for September.
/tags-*   /knowledge/  301

# Gridiron Gazette funnel was retired to archive/gazette-funnel/; the surviving
# Gazette content is the case study. 22 of September's 404 views were these.
/gazette            /case-studies/gridiron-gazette/  301
/gazette/           /case-studies/gridiron-gazette/  301
/gazette/*          /case-studies/gridiron-gazette/  301

# Other retired pages still receiving traffic.
/sales                              /services        301
/blogpost1                          /dialogues       301
/site-pages/scheduling              /contact         301
/site-pages/about-me---portfolio    /our-portfolio   301

# Malformed links with a literal space in the path. The space must be written
# as %20 here, because _redirects uses whitespace to separate its columns.
/services%20services   /services  301
/%20home               /          301

# The FAQ moved from /FAQ to lowercase /faq (2026-09-29). /faq was a 404 and is
# the address people type and paste. Cloudflare Pages matches both assets and
# these rules case-sensitively, so the two spellings cannot loop into each other.
/FAQ       /faq  301
/FAQ/      /faq  301
/FAQ.html  /faq  301

# DobieCore Captions and ContractKit were placeholder pages for products that
# are not shipping separately; both are folded into /dobiecore/ (2026-09-29).
# A 301 here rather than jekyll-redirect-from, because that plugin emits a 200
# HTML page with a meta refresh, and these were already indexed.
/dobiecore/captioncraft       /dobiecore/  301
/dobiecore/captioncraft/      /dobiecore/  301
/dobiecore/contracts          /dobiecore/  301
/dobiecore/contracts/         /dobiecore/  301
